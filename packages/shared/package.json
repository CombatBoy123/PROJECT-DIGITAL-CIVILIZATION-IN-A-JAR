{
  "name": "@civ/shared",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP and WebSocket contract (Zod schemas and DTO types) shared by server and web client.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@civ/sim-core": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
