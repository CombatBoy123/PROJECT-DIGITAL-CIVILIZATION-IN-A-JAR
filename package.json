{
  "name": "digital-civilization-in-a-jar",
  "private": true,
  "description": "An inspectable artificial society simulator: autonomous citizens, an internally consistent economy, auditable history and reproducible experiments.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @civ/server --filter @civ/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm db:migrate:e2e && pnpm --filter @civ/web test:e2e",
    "db:migrate": "pnpm --filter @civ/server db:migrate",
    "db:migrate:e2e": "node scripts/migrate-e2e.mjs",
    "db:generate": "pnpm --filter @civ/server db:generate",
    "benchmark": "pnpm --filter @civ/sim-core benchmark",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
