# Copy to .env and adjust. Never commit real credentials.

# PostgreSQL. The defaults match docker-compose.yml (local development only).
DATABASE_URL=postgresql://civ:civ@localhost:5432/civ_dev
# Used by the server integration tests. Its tables are truncated by the tests.
TEST_DATABASE_URL=postgresql://civ:civ@localhost:5432/civ_test

# HTTP server
HOST=127.0.0.1
PORT=3001
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Authentication.
#   disabled — no tokens; only accepted when HOST is a loopback address, and only
#              requests addressed to localhost / 127.0.0.1 / [::1] are answered.
#   token    — mutations need OPERATOR_TOKEN; reads need VIEWER_TOKEN when it is set.
AUTH_MODE=disabled
# For AUTH_MODE=token, generate each token with `openssl rand -hex 32` and paste the
# output after the = sign (24 characters minimum). Never use a value from a document.
#OPERATOR_TOKEN=
#VIEWER_TOKEN=

# Simulation runtime
CHECKPOINT_INTERVAL_MS=2000
MAX_BUFFERED_EVENTS=20000
FRAME_RATE=5
# Live stream (WebSocket) connections: in total, and per client IP address.
STREAM_MAX_CONNECTIONS=256
STREAM_MAX_CONNECTIONS_PER_ADDRESS=32
INVARIANT_CHECKS=every-tick
RESUME_RUNNING_ON_START=false
LOG_LEVEL=info
